DATABASE_URL=file:./data/vitrine360.db
# Required when DATABASE_URL points to Turso/libSQL (never commit the value)
DATABASE_AUTH_TOKEN=
# Vercel/Turso integration aliases accepted when DATABASE_* is absent
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
AUTH_SECRET=dev-secret-change-me-in-production-min-32-chars
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dedicated Experience Origin (RUNTIME-EXPERIENCE-05/06). Optional in local/dev.
# Production SHOULD set a distinct origin (DNS → same deployment) for cookie/storage isolation.
# Server + proxy:
# EXPERIENCE_ORIGIN=https://experience.example.com
# EXPERIENCE_ORIGIN_HOSTS=experience.example.com,experience.localhost
# Client sandbox host (EXPERIENCE-06) — mirror when the iframe runs in the browser:
# NEXT_PUBLIC_EXPERIENCE_ORIGIN=https://experience.example.com
# NEXT_PUBLIC_EXPERIENCE_ORIGIN_HOSTS=experience.example.com

# Google sign-in (server only). Leave empty until the OAuth client exists.
# Production redirect: https://vitrine360-psi.vercel.app/api/auth/google/callback
# Local redirect: http://localhost:3000/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Media storage: local | r2 | google_drive
MEDIA_STORAGE_PROVIDER=local
MEDIA_LOCAL_DIR=./uploads

# Optional Google Drive (when MEDIA_STORAGE_PROVIDER=google_drive)
# GOOGLE_DRIVE_CLIENT_EMAIL=
# GOOGLE_DRIVE_PRIVATE_KEY=
# GOOGLE_DRIVE_FOLDER_ID=

# Cloudflare R2 (when MEDIA_STORAGE_PROVIDER=r2)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# Device heartbeat: ms without beat before UI shows OFFLINE
HEARTBEAT_OFFLINE_AFTER_MS=90000
# Optional presence windows; production values must be reviewed explicitly
HEARTBEAT_ONLINE_WINDOW_MS=
HEARTBEAT_AWAY_WINDOW_MS=

# Upload limits
MAX_UPLOAD_BYTES=52428800

# PLATFORM-IDENTITY-04 — Control-plane identity foundation (server-side only).
# Default OFF. Absence / empty / any value other than true-like ⇒ disabled.
# Enabling does NOT grant platform access; assignments are explicit (PI-05+ authz).
# PLATFORM_IDENTITY_ENABLED=false

# PLATFORM-IDENTITY-10B — Entitlements foundation (server-side only).
# Default OFF. Schema/seed may exist; OFF means no entitlement behaviour change.
# ON prepares domain for later phases — PI-10B does NOT enforce quotas/features.
# ENTITLEMENTS_ENABLED=false

# Multi-tenant MVP: seed creates tenant slug "demo"
# Seed credentials are DEVELOPMENT ONLY — never deploy with default admin password.
# Optional login field tenantSlug when the same email exists in multiple tenants

# Playback Lab (server-side only; never NEXT_PUBLIC_). Default blocked when NODE_ENV=production.
# Set to true ONLY in Vercel Preview/staging for Browser E2E.
# PLAYBACK_LAB_ENABLED=false
